# Local development needs NO .env file. Use these only on Render / production.
DEBUG=False
SECRET_KEY=put-a-long-random-string-here
ALLOWED_HOSTS=your-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-portfolio.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com
DATABASE_URL=postgres://user:pass@host:5432/dbname
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
